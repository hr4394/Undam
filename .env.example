# ─────────────────────────────────────────────
# 운담 (Undam) 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 마세요.
# ─────────────────────────────────────────────

# 앱 기본 URL (배포 시 https 도메인)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 브랜드 / 연락처 (설정으로 쉽게 변경) ──────────
NEXT_PUBLIC_BRAND_NAME="운담"
NEXT_PUBLIC_BRAND_TAGLINE="동양의 사주와 서양의 별자리로 읽는 나의 두 가지 운명 지도"
NEXT_PUBLIC_CONTACT_EMAIL="help@undam.example"
NEXT_PUBLIC_CONTACT_BUSINESS="운담 (사업자정보는 출시 전 입력)"

# ── 데이터베이스 (PostgreSQL) ──────────────────
# 로컬 개발은 docker 또는 Supabase 등. 예: postgresql://user:pass@localhost:5432/undam
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/undam?schema=public"

# ── 개인정보 보존 기간 (일) ────────────────────
PERSONAL_DATA_RETENTION_DAYS="180"
# 임시 입력(브라우저 draft) 만료 (분)
DRAFT_TTL_MINUTES="120"

# ── 토큰 해시용 시크릿 (32바이트 이상 랜덤) ──────
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_HASH_SECRET="change-me-please-generate-a-long-random-secret"

# ── 관리자 ────────────────────────────────────
ADMIN_PASSWORD="change-me-admin-password"

# ── AI Synthesis Provider ─────────────────────
# provider: mock | anthropic | openai
AI_PROVIDER="mock"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MAX_OUTPUT_TOKENS="4000"
AI_TIMEOUT_MS="60000"
AI_MAX_RETRIES="2"

# ── 결제 (Toss Payments) ──────────────────────
# provider: mock | toss
PAYMENT_PROVIDER="mock"
# Toss 테스트 키 (https://docs.tosspayments.com 에서 발급)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxxxxxxxxxx"
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxxxxxxxxxx"
# 운영 환경(production)에서 mock 결제를 강제로 허용할지 (기본 false = 차단)
ALLOW_MOCK_PAYMENT_IN_PROD="false"

# ── 계산 정책 ─────────────────────────────────
# 진태양시(경도 기반 평균태양시 보정) 적용 여부
SAJU_USE_TRUE_SOLAR_TIME="true"
# 일 경계 정책: midnight | early-zi(자시 23시 기준 일주 변경)
SAJU_DAY_BOUNDARY="midnight"

# ── 이용권(크레딧) 상품 활성화 ─────────────────
ENABLE_CREDIT_PACKS="false"
